# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Env
.env
.env.*
!.env.example

# Node
node_modules/
dist/
.vite/

# Rust / Tauri
frontend/src-tauri/target/
frontend/src-tauri/Cargo.lock

# Editors/OS
.vscode/
# Per-machine dev-server launch config (absolute local paths, worktree ports)
.claude/launch.json
.idea/
.DS_Store
Thumbs.db

# Claude Code local-only settings
.claude/settings.local.json

# Logs
*.log

# Local SQLite dev databases. The -wal/-shm sidecars appear now that the app runs in WAL mode
# (see app/db.py configure_sqlite_pragmas) — they're part of the database, not separate artefacts.
backend/*.db
backend/*.db-wal
backend/*.db-shm
backend/*.dump

# PyInstaller build output
backend/build/
backend/dist/
frontend/src-tauri/binaries/

# design-sync (claude.ai/design) — staged converter, build output, machine state.
# .design-sync/{config.json,NOTES.md,conventions.md,previews/} are committed.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
